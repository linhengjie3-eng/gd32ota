; ============================================================================
; GD32F303VGT6  Bootloader  分散加载文件 (Keil MDK / armlink)
; Flash: 0x08000000, 16 KiB (0x4000)   SRAM: 0x20000000, 96 KiB (0x18000)
; ============================================================================
LR_IROM1 0x08000000 0x00004000  {
  ER_IROM1 0x08000000 0x00004000  {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00018000  {
    .ANY (+RW +ZI)
  }
}
