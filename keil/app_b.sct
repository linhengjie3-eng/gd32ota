; ============================================================================
; GD32F303VGT6  App Slot B  分散加载文件 (Keil MDK / armlink)
; Flash: 0x08080000, 512 KiB (0x80000)   SRAM: 0x20000000, 96 KiB
; 该地址落在 Flash Bank1, 页大小为 4 KiB; 编译必须定义 APP_SLOT_B。
; ============================================================================
LR_IROM1 0x08080000 0x00080000  {
  ER_IROM1 0x08080000 0x00080000  {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00018000  {
    .ANY (+RW +ZI)
  }
}
